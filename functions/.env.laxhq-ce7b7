# Non-secret settings for the live project (committed). Secrets live in Google Secret Manager.
# Stripe price ids: fill in after creating the products in Stripe (test mode first).
# While empty, the app shows "Checkout isn't set up yet" instead of opening Stripe.
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_SIBLING_YEAR=
# Daily Firestore backups: set to a Cloud Storage bucket name to turn them on.
BACKUP_BUCKET=laxhq-ce7b7-backups
# Set to true once App Check is registered (see README).
ENFORCE_APP_CHECK=false
