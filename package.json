{
  "name": "laxhq",
  "private": true,
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-laxhq \"node --test tests/rules.test.mjs\"",
    "test:functions": "firebase emulators:exec --only auth,firestore,functions --project demo-laxhq \"node --test tests/functions.test.mjs\"",
    "test": "npm run test:rules && npm run test:functions",
    "emulators": "firebase emulators:start --project demo-laxhq",
    "seed": "node scripts/seed-config.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^13.35.1"
  }
}
