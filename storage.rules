rules_version = '2';

// Receipts: readable and writable only by the family that owns them, and only on Pro.
service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{fid}/{file} {
      allow read: if request.auth != null && request.auth.token.fid == fid;
      allow create: if request.auth != null && request.auth.token.fid == fid
        && request.auth.token.pro == true
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if request.auth != null && request.auth.token.fid == fid
        && request.auth.token.pro == true;
    }
  }
}
